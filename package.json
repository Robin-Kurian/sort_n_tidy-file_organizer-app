{
  "name": "sort_and_tidy-file_organizer-app",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --debug",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "files",
    "organizer"
  ],
  "author": "Sort & Tidy",
  "license": "ISC",
  "dependencies": {
    "chokidar": "^4.0.3",
    "electron-log": "^5.2.4"
  },
  "description": "Sort & Tidy — automatically organize files in a folder by type",
  "build": {
    "appId": "com.sorttidy.app",
    "productName": "Sort & Tidy",
    "files": [
      "**/*",
      "!main.v1.js"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.utilities",
      "hardenedRuntime": false
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "sort_and_tidy-file_organizer-app",
      "synopsis": "Automatically organize files in a folder by type"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^34.0.1",
    "electron-builder": "^25.1.8"
  }
}
